  "keywords": [
    "node-red",
    "node-red-contrib",
    "alarm",
    "alarm-system",
    "security",
    "intrusion",
    "zone",
    "siren",
    "home-assistant",
    "mqtt",
    "knx",
    "iot",
    "smarthome",
    "home-automation"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Supergiovane/node-red-contrib-alarm-ultimate.git"
